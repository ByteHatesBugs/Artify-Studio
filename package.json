{
  "name": "artify-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A production-minded batch image-to-video workspace.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun --filter @artify/api build && bun --filter @artify/web build",
    "check": "bun --filter @artify/api check && bun --filter @artify/web check",
    "test": "bun --filter @artify/api test && bun --filter @artify/web test",
    "start": "bun --filter @artify/api start"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
