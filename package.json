{
  "name": "renderflow",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A production-minded batch image-to-video workspace.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun --filter @renderflow/api build && bun --filter @renderflow/web build",
    "check": "bun --filter @renderflow/api check && bun --filter @renderflow/web check",
    "test": "bun --filter @renderflow/api test && bun --filter @renderflow/web test",
    "start": "bun --filter @renderflow/api start"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
